<?php
/** @var array $rows @var int $total @var int $page @var int $pages @var array $filters @var array $statuses */
$f = $filters;
$q = function ($extra = []) use ($f, $baseLink) {
    $qs = array_merge([
        'search' => $f['search'], 'currency' => $f['currency'], 'network' => $f['network'],
        'status' => $f['status'], 'from' => $f['from'], 'to' => $f['to'],
    ], $extra);
    return $baseLink . '&action=crypto_tx&' . http_build_query($qs);
};
?>
<div class="chs-panel">
  <h3 style="margin-top:0;">Cryptocurrency Transactions</h3>
  <form method="get" class="form-inline" style="margin-bottom:12px;">
    <input type="hidden" name="module" value="cloudhost247services">
    <input type="hidden" name="action" value="crypto_tx">
    <input type="text" class="form-control input-sm" name="search" value="<?= chs_h($f['search']) ?>"
           placeholder="txid / invoice # / customer / email" style="width:280px;">
    <select name="currency" class="form-control input-sm">
      <option value="">All currencies</option>
      <?php foreach (['btc' => 'BTC', 'usdt' => 'USDT', 'bch' => 'BCH'] as $code => $label): ?>
        <option value="<?= $code ?>"<?= $f['currency'] === $code ? ' selected' : '' ?>><?= $label ?></option>
      <?php endforeach; ?>
    </select>
    <select name="network" class="form-control input-sm">
      <option value="">All networks</option>
      <option value="usdt"<?= $f['network'] === 'usdt' ? ' selected' : '' ?>>USDT network</option>
    </select>
    <select name="status" class="form-control input-sm">
      <option value="">All statuses</option>
      <?php foreach ($statuses as $label): ?>
        <option value="<?= chs_h($label) ?>"<?= $f['status'] === $label ? ' selected' : '' ?>><?= chs_h($label) ?></option>
      <?php endforeach; ?>
    </select>
    <input type="date" class="form-control input-sm" name="from" value="<?= chs_h($f['from']) ?>">
    <input type="date" class="form-control input-sm" name="to" value="<?= chs_h($f['to']) ?>">
    <button class="btn btn-primary btn-sm" type="submit">Filter</button>
    <a class="btn btn-default btn-sm" href="<?= chs_h($baseLink . '&action=crypto_tx') ?>">Reset</a>
  </form>

  <p class="chs-muted small">
    Read-only view of <code>blockonomics_orders</code>. No "mark as paid" exists here by design —
    crediting only happens via verified provider notifications. Accounting adjustments belong
    to the separate super-admin workflow in the operations guide.
  </p>

  <?php if (empty($rows)): ?>
    <div class="alert alert-info">No transactions match the current filters.</div>
  <?php else: ?>
  <table class="table table-striped table-condensed">
    <thead>
      <tr>
        <th>Transaction</th><th>Customer</th><th>Invoice</th><th>Currency</th>
        <th>Expected</th><th>Received</th><th>Address</th><th>Status</th>
        <th>Created</th><th>Invoice State</th>
      </tr>
    </thead>
    <tbody>
    <?php foreach ($rows as $r): ?>
      <tr>
        <td><code title="<?= chs_h($r['txid']) ?>"><?= chs_h(strlen($r['txid']) > 18 ? substr($r['txid'], 0, 10) . '…' . substr($r['txid'], -6) : $r['txid']) ?></code></td>
        <td>
          <?php if ($r['client_id']): ?>
            #<?= (int) $r['client_id'] ?> <?= chs_h($r['client_name']) ?><br>
            <span class="chs-muted small"><?= chs_h($r['client_email']) ?></span>
          <?php else: ?>
            <span class="chs-muted">—</span>
          <?php endif; ?>
        </td>
        <td><?= $r['order_id'] ? '#' . (int) $r['order_id'] : '—' ?></td>
        <td><?= strtoupper(chs_h($r['currency'])) ?></td>
        <td><?= chs_h(number_format($r['bits'], 0)) ?> <span class="chs-muted small">sats</span></td>
        <td><?= chs_h(number_format($r['bits_payed'], 0)) ?> <span class="chs-muted small">sats</span></td>
        <td><code><?= chs_h($r['address_masked']) ?></code></td>
        <td>
          <?php
            $cls = [ 'Paid' => 'success', 'Confirming' => 'info', 'Pending' => 'default',
                     'Failed' => 'danger', 'Expired' => 'warning', 'Cancelled' => 'default',
                     'Refunded' => 'default' ];
          ?><span class="label label-<?= isset($cls[$r['status']]) ? $cls[$r['status']] : 'default' ?>"><?= chs_h($r['status']) ?></span>
        </td>
        <td><?= chs_h(date('Y-m-d H:i', (int) $r['timestamp'])) ?></td>
        <td><?= chs_h($r['invoice_status'] !== '' ? $r['invoice_status'] : '—') ?></td>
      </tr>
    <?php endforeach; ?>
    </tbody>
  </table>
  <?php if ($pages > 1): ?>
    <nav>
      <ul class="pagination pagination-sm">
        <?php for ($p = 1; $p <= $pages; $p++): ?>
          <li<?= $p === (int) $page ? ' class="active"' : '' ?>><a href="<?= chs_h($q(['page' => $p])) ?>"><?= $p ?></a></li>
        <?php endfor; ?>
      </ul>
    </nav>
  <?php endif; ?>
  <?php endif; ?>
  <p class="chs-muted small">Total matching rows (unfiltered by normalized status): <?= (int) $total ?>.</p>
</div>
