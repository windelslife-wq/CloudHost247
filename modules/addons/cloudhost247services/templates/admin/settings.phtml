<?php
/** @var array $values @var array $secretKeys */
$bool = function ($key) use ($values) {
    return !empty($values[$key]) && in_array(strtolower($values[$key]), ['1','on','yes','true'], true);
};
$row = function ($label, $control, $hint = '') {
    return '<tr><td style="width:32%">' . $label . '</td><td>' . $control
        . ($hint !== '' ? '<div class="chs-muted small">' . $hint . '</div>' : '') . '</td></tr>';
};
$check = function ($key, $label) use ($bool) {
    return '<label><input type="checkbox" name="' . $key . '" ' . ($bool($key) ? 'checked' : '') . '> ' . $label . '</label>';
};
$text = function ($key, $values, $attrs = '') {
    return '<input class="form-control" name="' . $key . '" value="' . chs_h(isset($values[$key]) ? $values[$key] : '') . '" ' . $attrs . '>';
};
