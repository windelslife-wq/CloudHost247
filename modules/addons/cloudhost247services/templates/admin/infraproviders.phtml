<?php
/**
 * Admin → Infra Providers: provider configs (credentials sealed, masked) +
 * regions/datacenters per provider.
 *
 * @var array $providers @var array $regions @var array|null $editing
 * @var array $capabilities @var string $baseLink
 */
?>
<div class="chs-panel">
  <h3><?= $editing ? 'Edit provider' : 'Add provider' ?></h3>
  <form method="post" action="<?= chs_h($baseLink . '&action=infraproviders') ?>" class="form-horizontal">
    <?= $tokenField ?><input type="hidden" name="do" value="provider_save"><input type="hidden" name="provider_id" value="<?= (int) ($editing['id'] ?? 0) ?>">
    <table class="table">
      <tr><td style="width:22%">Name</td><td><input class="form-control" name="name" value="<?= chs_h($editing['name'] ?? '') ?>" required></td></tr>
      <tr><td>Base URL</td><td><input class="form-control" name="base_url" value="<?= chs_h($editing['base_url'] ?? '') ?>" placeholder="https://api.provider.example"></td></tr>
      <tr><td>Endpoint map (JSON)</td><td><textarea class="form-control" name="endpoints" rows="6" style="font-family:monospace"><?= chs_h($editing ? json_encode($editing['endpoints'], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) : '{
  "health":    "GET  /health",
  "images":    "GET  /images",
  "create":    "POST /servers",
  "status":    "GET  /servers/{server}",
  "start":     "POST /servers/{server}/start",
  "stop":      "POST /servers/{server}/stop",
  "reboot":    "POST /servers/{server}/reboot",
  "shutdown":  "POST /servers/{server}/shutdown",
  "delete":    "DELETE /servers/{server}",
  "reinstall": "POST /servers/{server}/reinstall",
  "rescue":    "POST /servers/{server}/rescue",
  "console":   "POST /servers/{server}/console",
  "metrics":   "GET  /servers/{server}/metrics",
  "configure": "POST /servers/{server}/configure"
}') ?></textarea>
        <div class="chs-muted small">operation → "METHOD /path/{server}". A capability is supported when its endpoint is mapped.</div></td></tr>
      <tr><td>Auth</td><td>
        <input class="form-control" name="auth_header" value="<?= chs_h($editing['auth_header'] ?? 'Authorization') ?>" placeholder="Authorization" style="width:180px;display:inline-block">
        <input class="form-control" name="auth_prefix" value="<?= chs_h($editing['auth_prefix'] ?? 'Bearer ') ?>" placeholder="Bearer " style="width:120px;display:inline-block">
        <input class="form-control" name="token_field" value="<?= chs_h($editing['token_field'] ?? 'api_key') ?>" placeholder="api_key" style="width:140px;display:inline-block">
      </td></tr>
      <tr><td>Credentials (JSON)</td><td><textarea class="form-control" name="credentials" rows="2" style="font-family:monospace" placeholder='{"api_key": "…"}'></textarea>
        <div class="chs-muted small"><?= !empty($editing['has_credentials']) ? 'Stored credentials exist — leave empty to keep them.' : 'Sealed with AES-256-GCM (CHS_CREDENTIALS_KEY); saving fails closed without the key. Never displayed.' ?></div></td></tr>
      <tr><td>Capabilities</td><td>
        <?php foreach ($capabilities as $cap): ?>
          <label style="margin-right:10px"><input type="checkbox" name="cap_<?= chs_h($cap) ?>" <?= !empty($editing['capabilities'][$cap]) ? 'checked' : '' ?>> <?= chs_h($cap) ?></label>
        <?php endforeach; ?>
      </td></tr>
      <tr><td>Flags</td><td>
        <label><input type="checkbox" name="is_enabled" <?= !isset($editing) || !empty($editing['is_enabled']) ? 'checked' : '' ?>> Enabled</label> &nbsp;
        <label><input type="checkbox" name="is_default" <?= !empty($editing['is_default']) ? 'checked' : '' ?>> Default provider</label>
      </td></tr>
    </table>
    <button class="btn btn-primary">Save provider</button>
    <?php if ($editing): ?><a class="btn btn-default" href="<?= chs_h($baseLink . '&action=infraproviders') ?>">Cancel</a><?php endif; ?>
  </form>
</div>

<div class="chs-panel">
  <h3>Providers</h3>
  <table class="table table-striped">
    <thead><tr><th>Name</th><th>Type</th><th>Health</th><th>Credentials</th><th>Flags</th><th></th></tr></thead>
    <tbody>
    <?php foreach ($providers as $p): ?>
      <tr>
        <td><strong><?= chs_h($p['name']) ?></strong><div class="chs-muted small"><?= chs_h($p['base_url']) ?></div></td>
        <td><code><?= chs_h($p['type']) ?></code></td>
        <td><?= chs_status_pill($p['health_status']) ?><?= $p['last_error'] !== '' ? '<div class="chs-muted small">' . chs_h($p['last_error']) . '</div>' : '' ?></td>
        <td><?= !empty($p['has_credentials']) ? '<span class="label label-success">sealed</span>' : '<span class="label label-default">none</span>' ?></td>
        <td class="small"><?= !empty($p['is_enabled']) ? 'enabled' : 'disabled' ?><?= !empty($p['is_default']) ? ' · default' : '' ?></td>
        <td class="text-nowrap">
          <a class="btn btn-xs btn-default" href="<?= chs_h($baseLink . '&action=infraproviders&edit=' . (int) $p['id']) ?>">Edit</a>
          <form method="post" action="<?= chs_h($baseLink . '&action=infraproviders') ?>" style="display:inline">
            <?= $tokenField ?><input type="hidden" name="do" value="provider_health"><input type="hidden" name="id" value="<?= (int) $p['id'] ?>">
            <button class="btn btn-xs btn-default">Health</button>
          </form>
          <form method="post" action="<?= chs_h($baseLink . '&action=infraproviders') ?>" style="display:inline" onsubmit="return confirm('Delete this provider? Refused while images/regions reference it.');">
            <?= $tokenField ?><input type="hidden" name="do" value="provider_delete"><input type="hidden" name="id" value="<?= (int) $p['id'] ?>">
            <button class="btn btn-xs btn-danger">Delete</button>
          </form>
        </td>
      </tr>
      <tr>
        <td colspan="6">
          <strong>Regions / datacenters</strong>
          <table class="table table-condensed" style="margin-top:6px">
            <thead><tr><th>Code</th><th>Name</th><th>Datacenter</th><th>Active</th><th></th></tr></thead>
            <tbody>
            <?php foreach (($regions[(int) $p['id']] ?? []) as $r): ?>
              <tr>
                <td><code><?= chs_h($r['code']) ?></code></td>
                <td><?= chs_h($r['name']) ?></td>
                <td><?= chs_h($r['datacenter']) ?></td>
                <td><?= chs_status_pill($r['is_active'] ? 'active' : 'disabled') ?></td>
                <td>
                  <form method="post" action="<?= chs_h($baseLink . '&action=infraproviders') ?>" style="display:inline" onsubmit="return confirm('Delete this region?');">
                    <?= $tokenField ?><input type="hidden" name="do" value="region_delete"><input type="hidden" name="id" value="<?= (int) $r['id'] ?>">
                    <button class="btn btn-xs btn-danger">Delete</button>
                  </form>
                </td>
              </tr>
            <?php endforeach; ?>
            <tr>
              <td colspan="5">
                <form method="post" action="<?= chs_h($baseLink . '&action=infraproviders') ?>" class="form-inline">
                  <?= $tokenField ?><input type="hidden" name="do" value="region_save"><input type="hidden" name="provider_id" value="<?= (int) $p['id'] ?>"><input type="hidden" name="region_id" value="0">
                  <input class="form-control input-sm" name="code" placeholder="fra" required>
                  <input class="form-control input-sm" name="name" placeholder="Frankfurt" required>
                  <input class="form-control input-sm" name="datacenter" placeholder="DC-1">
                  <label><input type="checkbox" name="is_active" checked> Active</label>
                  <button class="btn btn-xs btn-primary">Add region</button>
                </form>
              </td>
            </tr>
            </tbody>
          </table>
        </td>
      </tr>
    <?php endforeach; ?>
    </tbody>
  </table>
</div>
