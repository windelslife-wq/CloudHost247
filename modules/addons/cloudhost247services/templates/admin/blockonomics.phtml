/** @var array $state BlockonomicsAdmin::panelState() output */
$st = $state;
$on = function ($key) use ($st) { return !empty($st[$key]) ? ' checked' : ''; };
$toggle = function ($name, $label, $desc, $current) {
    return '<tr>'
        . '<td style="width:34%">' . $label . '</td>'
        . '<td><label class="chs-switch">'
        . '<input type="checkbox" name="' . $name . '"' . ($current ? ' checked' : '') . '> '
        . '<strong>' . ($current ? 'ON' : 'OFF') . '</strong></label>'
        . ($desc !== '' ? '<div class="chs-muted small">' . $desc . '</div>' : '')
        . '</td></tr>';
};
