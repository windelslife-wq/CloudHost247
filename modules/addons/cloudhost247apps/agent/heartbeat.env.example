# Copy to /etc/cloudhost247/heartbeat.env with mode 0600, owned by root.
# Populate from the real WHMCS installation; never commit credentials.
CH247_AGENT_WHMCS_URL=https://portal.example.com/
CH247_AGENT_UUID=replace-with-registered-agent-uuid
CH247_AGENT_SECRET_FILE=/etc/cloudhost247/heartbeat.secret
CH247_AGENT_VERSION=1.0.0
# Only after enabling the independent WHMCS uptime gate and staging /proc/uptime:
CH247_AGENT_UPTIME_ENABLED=0
