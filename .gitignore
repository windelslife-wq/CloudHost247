# Never re-introduce distribution archives into the repository
*.zip
*.tar
*.tar.gz
*.tgz
*.rar

# WHMCS runtime / generated
modules/*/*/logs/
modules/*/*/cache/
modules/servers/*/storage/logs/*.log
modules/servers/*/storage/crons/*.log

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# Domain Broker module runtime
modules/addons/domainbroker/node_modules
modules/addons/cloudhost247services/node_modules
modules/addons/cloudhost247ai/node_modules
modules/addons/cloudhost247marketing/node_modules
modules/addons/domainbroker/storage/*
!modules/addons/domainbroker/storage/.gitkeep
modules/addons/digitalproducts/storage/*
!modules/addons/digitalproducts/storage/.gitkeep
modules/addons/cloudhost247_cart_recovery/node_modules
modules/addons/CloudHost247_tools/node_modules
__pycache__/

# CloudHost247 App Cloud (application marketplace / deployment platform)
modules/addons/cloudhost247apps/node_modules
modules/addons/cloudhost247apps/storage/*
!modules/addons/cloudhost247apps/storage/.gitkeep
modules/addons/cloudhost247apps/logs/
modules/addons/cloudhost247apps/cache/

# Smtphosting usage proxy (S-6): upstream secrets and rate-limit counters are never committed
modules/servers/Smtphosting/storage/config/*.php
!modules/servers/Smtphosting/storage/config/index.php
modules/servers/Smtphosting/storage/app/smtp-usage-ratelimit/
modules/addons/cloudhost247cloudflare/node_modules
